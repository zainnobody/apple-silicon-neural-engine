+        // Test switch (M3 experiment): GGML_VK_HK_MWARP="BLOCK,BM,BN,BK,WM,WN,WMITER,TM,TN,TK,WARP"
+        // replaces the medium tile on Honeykrisp (quantized path with this BK, float path with BK 16).
+        if (device->driver_id == vk::DriverId::eMesaHoneykrisp && getenv("GGML_VK_HK_MWARP")) {
+            std::vector<uint32_t> w;
+            std::stringstream ss(getenv("GGML_VK_HK_MWARP"));
+            for (std::string tok; std::getline(ss, tok, ',');) {
+                w.push_back((uint32_t)std::stoul(tok));
+            }
+            if (w.size() == 11) {
+                m_warptile_mmq = w;
