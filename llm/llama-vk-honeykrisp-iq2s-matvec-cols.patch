+// Honeykrisp (Mesa on Apple G15): the iq2_s mat-vec shader with 3 or more columns needs a
+// spill frame of 8204 bytes, over the 8192 bytes the driver admits for compute, so
+// vkEndCommandBuffer fails with VK_ERROR_FEATURE_NOT_PRESENT. Those widths use the matrix path.
+static uint32_t ggml_vk_mul_mat_vec_cols_limit(const vk_device & device, ggml_type type) {
+    if (device->driver_id == vk::DriverId::eMesaHoneykrisp && type == GGML_TYPE_IQ2_S) {
+        return 2;
+    }
+    return mul_mat_vec_max_cols;
+}
